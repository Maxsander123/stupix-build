[Unit]
Description=Stupix Boot Init - Clone Repo and Run auto.sh
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/opt/stupix

[Service]
# Not oneshot: auto.sh runs long diagnostics (fio, memtester, ...) that must
# neither hold up boot nor be killed by a start timeout.
Type=exec
ExecStart=/usr/local/bin/stupix-init.sh
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
