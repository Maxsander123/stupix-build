#!/bin/bash

set -e

# ---------------------------------------------------------------------------
# Configurable repo source — override via environment variables for local or
# private-instance builds (Gitea, GitLab, Forgejo, GitHub Enterprise, …).
#
# Examples:
#   Public GitHub (default, no auth needed):
#     lb config   (or: auto/config)
#
#   Private Gitea/Forgejo/GitLab with user + token:
#     STUPIX_REPO=https://gitea.example.com/myorg/stupix \
#     STUPIX_REPO_USER=myuser \
#     STUPIX_REPO_TOKEN=mysecrettoken \
#     lb build
#
#   GitHub with PAT (token-only style):
#     STUPIX_REPO=https://github.com/myorg/stupix \
#     STUPIX_REPO_TOKEN=ghp_xxxx \
#     lb build
#
#   SSH (no STUPIX_REPO_USER/TOKEN needed — ensure key is reachable at boot):
#     STUPIX_REPO=git@gitea.example.com:myorg/stupix.git \
#     lb build
#
# STUPIX_REPO_TOKEN is stored in /etc/stupix/repo.conf inside the ISO.
# Use chmod 600 (already applied) and avoid leaking this ISO if the token
# grants write access to sensitive repos.
# ---------------------------------------------------------------------------

STUPIX_REPO="${STUPIX_REPO:-https://github.com/Maxsander123/stupix}"
STUPIX_REPO_USER="${STUPIX_REPO_USER:-}"
STUPIX_REPO_TOKEN="${STUPIX_REPO_TOKEN:-}"
STUPIX_ARCH="${STUPIX_ARCH:-amd64}"

mkdir -p config/includes.chroot/etc/stupix
cat > config/includes.chroot/etc/stupix/repo.conf << REPOCONF
STUPIX_REPO="${STUPIX_REPO}"
STUPIX_REPO_USER="${STUPIX_REPO_USER}"
STUPIX_REPO_TOKEN="${STUPIX_REPO_TOKEN}"
REPOCONF
chmod 600 config/includes.chroot/etc/stupix/repo.conf

echo "Repo config baked into ISO:"
echo "  STUPIX_REPO      = ${STUPIX_REPO}"
echo "  STUPIX_REPO_USER = ${STUPIX_REPO_USER:-<none>}"
echo "  STUPIX_REPO_TOKEN= ${STUPIX_REPO_TOKEN:+<set>}${STUPIX_REPO_TOKEN:-<none>}"
echo "  STUPIX_ARCH      = ${STUPIX_ARCH}"

# amd64:   BIOS (syslinux/isolinux) + UEFI (grub-efi) — boots on everything
# arm64:   UEFI only (all ARM servers/modern boards use UEFI), cross-built via qemu-user-static
# riscv64: UEFI only, cross-built via qemu-user-static. Debian trixie, because
#          riscv64 became an official Debian architecture with trixie —
#          bookworm has no riscv64 port.
DISTRIBUTION=bookworm
ARCHIVE_AREAS="main contrib non-free non-free-firmware"
SECURE_BOOT=auto
case "$STUPIX_ARCH" in
    amd64)
        BOOTLOADERS="grub-efi,syslinux"
        CROSS_OPTS=""
        # Kernel output on COM1 (IPMI SOL / VM serial) and the screen; the
        # last console= is /dev/console, so the screen stays primary.
        CONSOLE="console=ttyS0,115200n8 console=tty0"
        ;;
    arm64)
        BOOTLOADERS="grub-efi"
        if [ -f "/usr/bin/qemu-aarch64-static" ]; then
            CROSS_OPTS="--bootstrap-qemu-arch arm64 --bootstrap-qemu-static /usr/bin/qemu-aarch64-static"
        else
            CROSS_OPTS=""
        fi
        # No console= — the kernel picks the UART from ACPI SPCR / device tree
        # (ttyAMA0, ttyS0, … differs per board)
        CONSOLE=""
        ;;
    riscv64)
        DISTRIBUTION=trixie
        # trixie's live-build also takes firmware from contrib, which pulls in
        # firmware-b43*-installer: they download Broadcom WiFi firmware at
        # install time and fail the build when that download fails
        ARCHIVE_AREAS="main non-free non-free-firmware"
        BOOTLOADERS="grub-efi"
        # No shim / signed GRUB exists for riscv64
        SECURE_BOOT=disable
        if [ -f "/usr/bin/qemu-riscv64-static" ]; then
            CROSS_OPTS="--bootstrap-qemu-arch riscv64 --bootstrap-qemu-static /usr/bin/qemu-riscv64-static"
        else
            CROSS_OPTS=""
        fi
        # Stock live-build has no riscv64 UEFI support — see ci/live-build-riscv64.sh
        if ! grep -qs riscv64-efi /usr/lib/live/build/binary_grub-efi; then
            echo "E: live-build cannot build riscv64 UEFI images yet." >&2
            echo "E: Run 'sudo ci/live-build-riscv64.sh' once, then retry." >&2
            exit 1
        fi
        # No console= — the kernel picks the UART from the device tree / ACPI SPCR
        CONSOLE=""
        ;;
    *)
        BOOTLOADERS="grub-efi"
        CROSS_OPTS=""
        CONSOLE=""
        ;;
esac

echo "  DISTRIBUTION     = ${DISTRIBUTION}"

# Security updates: live-build adds <distribution>-security itself

lb config noauto \
    --architectures "$STUPIX_ARCH" \
    --distribution "$DISTRIBUTION" \
    --archive-areas "$ARCHIVE_AREAS" \
    --initramfs live-boot \
    --binary-images iso-hybrid \
    --bootloaders "$BOOTLOADERS" \
    --bootappend-live "boot=live components nomodeset net.ifnames=0 biosdevname=0 ${CONSOLE}" \
    --iso-publisher "Stupix Project" \
    --iso-volume "Stupix Live" \
    --apt-recommends false \
    --keyring-packages debian-archive-keyring \
    --uefi-secure-boot "$SECURE_BOOT" \
    $CROSS_OPTS \
    "${@}"
