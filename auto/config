#!/bin/sh
set -e
lb config noauto \
    --architectures amd64 \
    --linux-flavours amd64 \
    --distribution bookworm \
    --binary-images iso-hybrid \
    --bootstrap-flavour minimal \
    --bootappend-live "boot=live components hostname=stupix username=root noeject noprompt quiet net.ifnames=0 biosdevname=0" \
    --memtest none \
    --iso-application "Stupix Server Diagnostics" \
    --iso-volume "STUPIX" \
    --apt-recommends false \
    --compression xz \
    "${@}"
